{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "service": "backend"
    },
    {
      "src": "/(.*)",
      "service": "frontend"
    }
  ]
}
